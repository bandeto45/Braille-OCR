<template>
  <div class="page no-navbar no-toolbar preloader-page" data-name="preloader">
    <div class="page-content">
      <div class="splash-icon">
        <i class="icon material-icons">visibility</i>
      </div>
      <div class="splash-title">Braille</div>
      <div class="splash-subtitle">OCR Scanner</div>
      <div class="splash-progress">
        <div class="splash-progress-fill" style="width: ${progress}%"></div>
      </div>
      <div class="splash-status">${statusText}</div>
      ${hasError && $h`
        <div class="mt-5">
          <button class="btn-braille-primary" style="width: 160px;" @click=${retry}>
            <i class="icon material-icons">refresh</i>
            Retry
          </button>
        </div>
      `}
    </div>
  </div>
</template>

<script>
import { initializeDetector } from '../js/detection/simple-braille-detector.js';

export default (props, { $f7, $store, $update, $on }) => {
  let progress   = 0;
  let statusText = 'Initializing...';
  let hasError   = false;
  let ticker     = null;

  async function runInit() {
    hasError   = false;
    progress   = 0;
    statusText = 'Initializing OpenCV...';
    $update();

    // Animate progress bar while async init runs
    ticker = setInterval(() => {
      if (progress < 80) { progress += 20; $update(); }
    }, 100);

    try {
      await initializeDetector();
      clearInterval(ticker);
      ticker     = null;
      progress   = 100;
      statusText = 'Ready!';
      $store.dispatch('setTemplatesLoaded', true);
      if (!$f7.data) $f7.data = {};
      $f7.data.detectorReady = true;
      $update();
      setTimeout(() => {
        $f7.views.main.router.navigate('/home/', { clearPreviousHistory: true });
      }, 300);
    } catch (err) {
      clearInterval(ticker);
      ticker     = null;
      hasError   = true;
      statusText = 'Initialization failed.';
      console.error('[Preloader] initializeDetector error:', err);
      $update();
    }
  }

  function retry() { runInit(); }

  $on('pageInit', () => { runInit(); });

  return $render;
};
</script>
